<?xml version="1.0"?>
<ruleset name="Codereyes Mobile Shop">
	<file>.</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>tests/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<rule ref="WordPress"/>
	<!-- Templates keep short inline arrays on one line so attributes stay on one line. -->
	<rule ref="WordPress.Arrays.ArrayDeclarationSpacing.AssociativeArrayFound">
		<exclude-pattern>views/*</exclude-pattern>
	</rule>
	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
